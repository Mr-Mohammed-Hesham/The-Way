rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Catch-all Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Authentication & Validation Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 256;
    }

    function incoming() {
      return request.resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@theway.local' ||
        request.auth.token.email == 'hesham@theway.local' ||
        (
          request.auth.token.email_verified == true && (
            request.auth.token.email == 'mr.mohamed.hesham93@gmail.com' ||
            request.auth.token.email == 'mohammedhesham872@gmail.com'
          )
        ) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['SUPER_ADMIN', 'ADMIN']
        )
      );
    }

    function isValidStudent(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200;
    }

    function isValidTeacher(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200;
    }

    function isValidSubject(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             (!('defaultSessionPrice' in data) || data.defaultSessionPrice == null || data.defaultSessionPrice is number);
    }

    function isValidRoom(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.capacity is number;
    }

    function isValidSession(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.teacherId is string && data.teacherId.size() <= 128 &&
             data.subjectId is string && data.subjectId.size() <= 128 &&
             data.date is string && data.date.size() <= 32;
    }

    function isValidAttendance(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.sessionId is string && data.sessionId.size() <= 128 &&
             data.studentId is string && data.studentId.size() <= 128 &&
             data.status is string && data.status.size() <= 32;
    }

    function isValidContract(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.studentId is string && data.studentId.size() <= 128 &&
             data.totalSessions is number &&
             (!('totalPrice' in data) || data.totalPrice is number) &&
             (!('packagePrice' in data) || data.packagePrice is number);
    }

    function isValidPayment(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.studentId is string && data.studentId.size() <= 128 &&
             data.amount is number;
    }

    function isValidSettings(data) {
      return data.centerName is string && data.centerName.size() > 0 && data.centerName.size() <= 200;
    }

    function isValidAuditLog(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.action is string && data.action.size() <= 64;
    }

    function isValidNotification(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 512;
    }

    function isValidAssignment(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.teacherId is string && data.teacherId.size() <= 128 &&
             data.subjectId is string && data.subjectId.size() <= 128;
    }

    function isValidTeacherPayment(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.teacherId is string && data.teacherId.size() <= 128 &&
             data.amount is number;
    }

    function isValidUser(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.role is string && data.role.size() <= 64;
    }

    // --- Collections (Authenticated Center Staff) ---

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin() && isValidId(userId);
    }

    match /students/{studentId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(studentId) && isValidStudent(incoming());
      allow delete: if isSignedIn() && isValidId(studentId);
    }

    match /teachers/{teacherId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(teacherId) && isValidTeacher(incoming());
      allow delete: if isSignedIn() && isValidId(teacherId);
    }

    match /subjects/{subjectId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(subjectId) && isValidSubject(incoming());
      allow delete: if isSignedIn() && isValidId(subjectId);
    }

    match /rooms/{roomId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(roomId) && isValidRoom(incoming());
      allow delete: if isSignedIn() && isValidId(roomId);
    }

    match /sessions/{sessionId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(sessionId) && isValidSession(incoming());
      allow delete: if isSignedIn() && isValidId(sessionId);
    }

    match /attendance/{attendanceId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(attendanceId) && isValidAttendance(incoming());
      allow delete: if isSignedIn() && isValidId(attendanceId);
    }

    match /contracts/{contractId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(contractId) && isValidContract(incoming());
      allow delete: if isSignedIn() && isValidId(contractId);
    }

    match /payments/{paymentId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(paymentId) && isValidPayment(incoming());
      allow delete: if isSignedIn() && isValidId(paymentId);
    }

    match /settings/{settingId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(settingId) && isValidSettings(incoming());
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(logId) && isValidAuditLog(incoming());
      allow delete: if isAdmin() && isValidId(logId);
    }

    match /notifications/{notificationId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming());
      allow delete: if isSignedIn() && isValidId(notificationId);
    }

    match /assignments/{assignmentId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(assignmentId) && isValidAssignment(incoming());
      allow delete: if isSignedIn() && isValidId(assignmentId);
    }

    match /teacherPayments/{paymentId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(paymentId) && isValidTeacherPayment(incoming());
      allow delete: if isSignedIn() && isValidId(paymentId);
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Boot health check endpoint
    match /test/{docId} {
      allow get: if true;
      allow write: if isSignedIn();
    }
  }
}
